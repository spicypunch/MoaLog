POSTGRES_DB=moalog
POSTGRES_USER=moalog
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Optional overrides when running the Spring server outside Docker Compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/moalog
SPRING_DATASOURCE_USERNAME=moalog
SPRING_DATASOURCE_PASSWORD=local-development-only

# Replace these placeholders before starting the server. Generate a 32-byte signing key with:
# openssl rand -base64 32
MOALOG_AUTH_ACCESS_TOKEN_ISSUER=https://api.local.moalog
MOALOG_AUTH_ACCESS_TOKEN_AUDIENCE=moalog-mobile
MOALOG_AUTH_ACCESS_TOKEN_SECRET_BASE64=replace-with-generated-base64-secret
MOALOG_AUTH_GOOGLE_AUDIENCE=replace-with-google-client-id
MOALOG_AUTH_APPLE_AUDIENCE=replace-with-apple-service-or-bundle-id

# Optional authentication policy overrides.
MOALOG_AUTH_ACCESS_TOKEN_TTL=PT15M
MOALOG_AUTH_REFRESH_TOKEN_TTL=P30D
MOALOG_AUTH_LOGIN_CHALLENGE_TTL=PT5M
MOALOG_AUTH_MAX_ACTIVE_LOGIN_CHALLENGES=10000
MOALOG_AUTH_MAX_ACTIVE_LOGIN_CHALLENGES_PER_DEVICE=20
MOALOG_AUTH_MAX_ACTIVE_LOGIN_CHALLENGES_PER_SOURCE=200
MOALOG_AUTH_MAX_EXCHANGE_ATTEMPTS_PER_CHALLENGE=5
MOALOG_HOUSEHOLD_INVITATION_TTL=P7D
